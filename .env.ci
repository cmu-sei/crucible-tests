# Crucible Service URLs — CI target (published cmusei/*:main images)
# Used when CRUCIBLE_TARGET=ci.
# Each app is on its own localhost port, same as Aspire.

# Infrastructure
KEYCLOAK_URL=https://localhost:8443
KEYCLOAK_REALM_URL=https://localhost:8443/realms/crucible

# Player
PLAYER_UI_URL=http://localhost:4301
PLAYER_API_URL=http://localhost:4300

# Player VM
PLAYERVM_UI_URL=http://localhost:4303
PLAYERVM_API_URL=http://localhost:4302

# Console
CONSOLE_UI_URL=http://localhost:4305

# Caster
CASTER_UI_URL=http://localhost:4310
CASTER_API_URL=http://localhost:4309
# Gitea, Caster's module source (serves the test module catalog)
GITEA_URL=http://localhost:3010

# Alloy
ALLOY_UI_URL=http://localhost:4403
ALLOY_API_URL=http://localhost:4402

# TopoMojo
TOPOMOJO_UI_URL=http://localhost:4201
TOPOMOJO_API_URL=http://localhost:5000

# Steamfitter
STEAMFITTER_UI_URL=http://localhost:4401
STEAMFITTER_API_URL=http://localhost:4400

# CITE
CITE_UI_URL=http://localhost:4721
CITE_API_URL=http://localhost:4720

# Gallery
GALLERY_UI_URL=http://localhost:4723
GALLERY_API_URL=http://localhost:4722

# Blueprint
BLUEPRINT_UI_URL=http://localhost:4725
BLUEPRINT_API_URL=http://localhost:4724

# Gameboard
GAMEBOARD_UI_URL=http://localhost:4202
GAMEBOARD_API_URL=http://localhost:5002

# Postgres (CI-specific overrides for docker compose stack)
CRUCIBLE_POSTGRES_HOST=127.0.0.1
CRUCIBLE_POSTGRES_PORT=5432
CRUCIBLE_POSTGRES_PASSWORD=crucible-ci
