{
  "name": "crucible-tests",
  "version": "1.0.0",
  "description": "Playwright Test Agents for Crucible platform",
  "private": true,
  "scripts": {
    "test": "playwright test",
    "test:ui": "playwright test --ui",
    "test:debug": "playwright test --debug",
    "test:headed": "playwright test --headed",
    "test:report": "playwright show-report",
    "test:codegen": "playwright codegen",
    "typecheck": "tsc --noEmit",
    "check:skips": "node scripts/check-self-skips.mjs",
    "check:discovery": "playwright test --list --reporter=list",
    "validate": "npm run typecheck && npm run check:skips && npm run check:discovery"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@playwright/test": "^1.64.1",
    "@types/node": "^25.5.2",
    "@types/pg": "^8.23.1",
    "axe-core": "^4.11.3",
    "dotenv": "^17.4.1",
    "pg": "^8.23.1",
    "typescript": "5.9.3"
  }
}
