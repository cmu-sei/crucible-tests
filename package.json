{
  "name": "crucible-tests",
  "version": "1.0.0",
  "description": "Playwright Test Agents for Crucible platform",
  "private": true,
  "scripts": {
    "test": "playwright test",
    "test:ui": "playwright test --ui",
    "test:debug": "playwright test --debug",
    "test:headed": "playwright test --headed",
    "test:report": "playwright show-report",
    "test:codegen": "playwright codegen",
    "typecheck": "tsc --noEmit",
    "check:skips": "node scripts/check-self-skips.mjs",
    "check:waits": "node scripts/check-wait-antipatterns.mjs",
    "check:run-filters": "node --no-warnings scripts/check-run-filters.mjs",
    "check:discovery": "playwright test --list --reporter=list",
    "validate": "npm run typecheck && npm run check:skips && npm run check:waits && npm run check:run-filters && npm run check:discovery",
    "report:durations": "node scripts/report-durations.mjs"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@playwright/test": "^1.64.1",
    "@types/node": "^26.6.5",
    "@types/pg": "^8.23.1",
    "axe-core": "^4.11.3",
    "dotenv": "^18.0.7",
    "pg": "^8.23.1",
    "typescript": "7.0.2"
  }
}
