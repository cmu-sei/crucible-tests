# Ported from AppHost.cs AddAlloy (alloy-api, lines 651-672). The Moodle CORS origins
# are dropped (no Moodle in CI). ResourceOwnerAuthorization__ClientSecret comes from
# .generated/alloy-api.secrets.env, which prepare.sh reads out of crucible-realm.json.
ASPNETCORE_URLS=http://+:4402
ConnectionStrings__PostgreSQL=Host=localhost;Port=5432;Username=postgres;Password=crucible-ci;Include Error Detail=True;Database=alloy
Authorization__ClientId=alloy.api
ResourceOwnerAuthorization__Authority=https://localhost:8443/realms/crucible
ResourceOwnerAuthorization__ClientId=alloy.admin
ResourceOwnerAuthorization__UserName=crucible-admin
ResourceOwnerAuthorization__Password=admin
ResourceOwnerAuthorization__Scope=player player-vm alloy steamfitter caster
ResourceOwnerAuthorization__ValidateDiscoveryDocument=false
CorsPolicy__Origins__0=http://localhost:4403
