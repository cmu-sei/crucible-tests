# Ported from AppHost.cs AddGameboard (gameboard, lines 1080-1103).
# GameEngine__ClientSecret comes from .generated/gameboard-api.secrets.env, which
# prepare.sh reads out of crucible-realm.json.
# ASPNETCORE_URLS also overrides the image's http://*:80.
ASPNETCORE_URLS=http://+:5002
ASPNETCORE_ENVIRONMENT=Development
ConnectionStrings__PostgreSQL=Host=localhost;Port=5432;Username=postgres;Password=crucible-ci;Include Error Detail=True;Database=gameboard
Database__ConnectionString=Host=localhost;Port=5432;Username=postgres;Password=crucible-ci;Include Error Detail=True;Database=gameboard
Database__Provider=PostgreSQL
Database__DevModeRecreate=false
PathBase=
Oidc__Authority=https://localhost:8443/realms/crucible
Oidc__Audience=gameboard
Oidc__RequireHttpsMetadata=false
Oidc__UserRolesClaimMap__Administrator=Admin
OpenApi__Client__AuthorizationUrl=https://localhost:8443/realms/crucible/protocol/openid-connect/auth
OpenApi__Client__TokenUrl=https://localhost:8443/realms/crucible/protocol/openid-connect/token
OpenApi__Client__ClientId=gameboard.api
OpenApi__Enabled=true
Core__GameEngineUrl=http://localhost:5000/api
Core__ChallengeDocUrl=http://localhost:5000/api
GameEngine__ClientId=topomojo.api
Headers__Cors__Origins__0=http://localhost:4202
Headers__Cors__Methods__0=*
Headers__Cors__Headers__0=*
Headers__Cors__AllowCredentials=true
