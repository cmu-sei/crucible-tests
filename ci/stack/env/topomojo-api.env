# Ported from AppHost.cs AddTopoMojo (topomojo, lines 709-732). The Moodle CORS
# origins and the launchpoint settings are dropped (neither runs in CI).
ASPNETCORE_URLS=http://+:5000
ASPNETCORE_ENVIRONMENT=Development
ConnectionStrings__PostgreSQL=Host=localhost;Port=5432;Username=postgres;Password=crucible-ci;Include Error Detail=True;Database=topomojo
Database__ConnectionString=Host=localhost;Port=5432;Username=postgres;Password=crucible-ci;Include Error Detail=True;Database=topomojo
Database__Provider=PostgreSQL
Database__DevModeRecreate=false
Oidc__Authority=https://localhost:8443/realms/crucible
Oidc__Audience=topomojo
Oidc__RequireHttpsMetadata=false
# TopoMojo's default map only matches lowercase "administrator"; Keycloak sends "Administrator".
Oidc__UserRolesClaimMap__Administrator=Administrator
OpenApi__Client__AuthorizationUrl=https://localhost:8443/realms/crucible/protocol/openid-connect/auth
OpenApi__Client__TokenUrl=https://localhost:8443/realms/crucible/protocol/openid-connect/token
OpenApi__Client__ClientId=topomojo.api
Headers__Cors__Origins__0=http://localhost:4201
Headers__Cors__Methods__0=*
Headers__Cors__Headers__0=*
Headers__Cors__AllowCredentials=true
