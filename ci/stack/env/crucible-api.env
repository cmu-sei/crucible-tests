# Settings shared by every Crucible-style API (Player, VM, Caster, Alloy, Steamfitter,
# CITE, Gallery, Blueprint); the same values each AddProject block in
# crucible-development Crucible.AppHost/AppHost.cs sets. TopoMojo and Gameboard use
# their own option names and don't load this file.
ASPNETCORE_ENVIRONMENT=Development
# Several APIs default to Sqlite.
Database__Provider=PostgreSQL
Database__DevModeRecreate=false
Authorization__Authority=https://localhost:8443/realms/crucible
Authorization__AuthorizationUrl=https://localhost:8443/realms/crucible/protocol/openid-connect/auth
Authorization__TokenUrl=https://localhost:8443/realms/crucible/protocol/openid-connect/token
