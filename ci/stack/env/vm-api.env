# Ported from AppHost.cs AddPlayerVm (player-vm-api, lines 463-479).
ASPNETCORE_URLS=http://+:4302
ConnectionStrings__PostgreSQL=Host=localhost;Port=5432;Username=postgres;Password=crucible-ci;Include Error Detail=True;Database=player_vm
VmUsageLogging__Enabled=true
VmUsageLogging__PostgreSQL=Host=localhost;Port=5432;Username=postgres;Password=crucible-ci;Include Error Detail=True;Database=player_vm_logging
Authorization__ClientId=player.vm.api
IdentityClient__TokenUrl=https://localhost:8443/realms/crucible/protocol/openid-connect/token
IdentityClient__ClientId=player.vm.admin
IdentityClient__UserName=crucible-admin
IdentityClient__Password=admin
# No hypervisor in CI: the default config has one vSphere host entry with no address.
Vsphere__Hosts__0__Enabled=false
